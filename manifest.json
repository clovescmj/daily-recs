{
  "manifest_version": 3,
  "name": "Daily Recs for Bandcamp",
  "version": "0.2.0",
  "description": "Fresh Bandcamp recommendations every day, based on your own collection. Never shows what you already own.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["alarms", "contextMenus", "scripting", "storage"],
  "host_permissions": ["https://*.bandcamp.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Daily Recs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://bandcamp.com/*"],
      "js": ["src/player/bandcamp-player.js", "src/content/profile-tab.js"],
      "css": ["src/player/bandcamp-player.css", "src/content/profile-tab.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/pages/recs/recs.html", "src/assets/*"],
      "matches": ["https://bandcamp.com/*"]
    }
  ]
}
